# MCP client bearer token. At least 16 characters. This is not the HACCP user password.
MCP_BEARER_TOKEN=replace-with-a-long-random-token

# Inside Docker the process listens on all container interfaces.
# The published host address is what keeps it off the public internet.
MCP_BIND_HOST=0.0.0.0
MCP_PORT=8765
MCP_IN_DOCKER=1

# 127.0.0.1 for an SSH tunnel, or the NAS Tailscale IP (100.x.x.x).
# 0.0.0.0 is rejected at startup.
MCP_PUBLISH_HOST=127.0.0.1
MCP_PUBLISH_PORT=8765

# Host headers accepted by DNS-rebinding protection. Add the Tailscale IP.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# Advertised resource URL. Use the same host clients use to connect.
MCP_RESOURCE_URL=http://127.0.0.1:8765

# Existing E_HACCP API. Compose service name is "backend".
HACCP_API_BASE_URL=http://backend:8000

# Dedicated application user. Recommended role: Admin, so /admin/activity works.
# The MCP client issues GET requests only, plus the login POST.
HACCP_SERVICE_USERNAME=mcp-reader
HACCP_SERVICE_PASSWORD=replace-with-the-service-account-password

# Optional. Leave empty to use the API only.
# Create the role first with sql/create_readonly_role.sql. Do not use the app owner.
# Dev Postgres listens on 5555; prod Postgres listens on 5432.
HACCP_READONLY_DATABASE_URL=

# JSON lines, one object per tool call. Leave empty to log only to stdout.
MCP_AUDIT_LOG_PATH=/var/log/ehaccp-mcp/audit.jsonl
